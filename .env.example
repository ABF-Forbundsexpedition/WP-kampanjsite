# Exempel – i normalfallet genereras .env av newsite.sh med slumpade
# lösenord och salter. Kopiera bara denna fil manuellt om du vet vad du gör.
DOMAIN=kampanj.example.se
PORT=8001
SFTP_PORT=20001
SFTP_USER=upload
SFTP_PASSWORD=genereras_av_newsite
CERT_EMAIL=
MYSQL_ROOT_PASSWORD=genereras_av_newsite
MYSQL_PASSWORD=genereras_av_newsite
WP_AUTH_KEY=genereras_av_newsite
WP_SECURE_AUTH_KEY=genereras_av_newsite
WP_LOGGED_IN_KEY=genereras_av_newsite
WP_NONCE_KEY=genereras_av_newsite
WP_AUTH_SALT=genereras_av_newsite
WP_SECURE_AUTH_SALT=genereras_av_newsite
WP_LOGGED_IN_SALT=genereras_av_newsite
WP_NONCE_SALT=genereras_av_newsite
